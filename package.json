{
  "name": "dorms-check",
  "version": "0.3.2",
  "description": "교사 앱의 공개 응답과 코드를 최소 점검하고 확인한 위험·권고·미확인을 알려주는 도구. 선택적으로 에듀집 서류와 앱 보호 계획을 준비한다.",
  "type": "module",
  "bin": {
    "dcheck": "bin/dcheck.js"
  },
  "exports": {
    ".": "./core/index.js",
    "./checks/external": "./checks/external/index.js",
    "./checks/runtime": "./checks/runtime/index.js"
  },
  "scripts": {
    "assets:internal-approval": "node scripts/generate-internal-approval-template.mjs",
    "selftest": "node verify/self-test.js && node verify/minimum-test.js && node verify/legacy-hooks-test.js && node verify/pem-regression-test.js && node verify/school-selfcheck.test.js",
    "scan": "node bin/dcheck.js scan",
    "test:legacy-hooks": "node verify/legacy-hooks-test.js"
  },
  "keywords": [
    "security",
    "privacy",
    "supabase",
    "rls",
    "vibe-coding",
    "korea",
    "education",
    "personal-information-protection",
    "security-scanner"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "홍창욱 (Team DoRm)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinnanchanguk/dorms-check.git"
  },
  "homepage": "https://github.com/shinnanchanguk/dorms-check#readme",
  "bugs": {
    "url": "https://github.com/shinnanchanguk/dorms-check/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "core",
    "checks",
    "catalog",
    "protect",
    "ai",
    "templates",
    "schema",
    "docs",
    "verify",
    "skills",
    "assets",
    "LICENSE",
    "NOTICE.md",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "README.ko.md",
    "SETUP.md",
    "DISCLAIMER.md",
    "USE-WITH-AI.md"
  ],
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "hwp-convert": "1.13.0",
    "pdfkit": "0.17.2"
  }
}
