{
  "name": "dorms-check",
  "version": "0.2.0",
  "description": "교사가 만든 앱을 보안·에듀집·지식재산권 세 축으로 점검하고, 에듀집 제출 자료와 승인 뒤 학교 내부 기안·학운위 HWPX 문서를 만드는 코치. 외부 제출은 하지 않는다.",
  "type": "module",
  "bin": {
    "dcheck": "bin/dcheck.js"
  },
  "exports": {
    ".": "./core/index.js",
    "./checks/external": "./checks/external/index.js",
    "./checks/runtime": "./checks/runtime/index.js"
  },
  "scripts": {
    "assets:internal-approval": "node scripts/generate-internal-approval-template.mjs",
    "selftest": "node verify/self-test.js && node verify/strict-test.js",
    "test:strict": "node verify/strict-test.js",
    "test:windows": "node verify/windows-powershell-test.js",
    "scan": "node bin/dcheck.js scan"
  },
  "keywords": [
    "security",
    "privacy",
    "supabase",
    "rls",
    "vibe-coding",
    "korea",
    "education",
    "personal-information-protection",
    "security-scanner"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "홍창욱 (Team DoRm)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinnanchanguk/dorms-check.git"
  },
  "homepage": "https://github.com/shinnanchanguk/dorms-check#readme",
  "bugs": {
    "url": "https://github.com/shinnanchanguk/dorms-check/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "core",
    "checks",
    "hooks",
    "catalog",
    "protect",
    "ai",
    "templates",
    "schema",
    "docs",
    "verify",
    "skills",
    "assets",
    "LICENSE",
    "NOTICE.md",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "README.ko.md",
    "SETUP.md",
    "DISCLAIMER.md",
    "USE-WITH-AI.md"
  ],
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "hwp-convert": "1.13.0",
    "pdfkit": "0.17.2"
  }
}
